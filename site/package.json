{
  "name": "node-bonsai-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build:playground": "vite build -c vite.playground.config.ts",
    "dev": "concurrently -k -n playground,astro \"vite build -c vite.playground.config.ts --watch\" \"astro dev\"",
    "build": "npm run build:playground && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@xterm/xterm": "^5.5.0",
    "astro": "^7.4.5",
    "chalk": "^5.6.2",
    "ink": "^6.8.0",
    "ink-web": "0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "vite": "^8.0.0"
  }
}
